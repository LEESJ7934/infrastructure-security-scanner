{
  "name": "scanner-p2net",
  "services": {
    "router": {
      "build": {"context": ".", "dockerfile": "Dockerfile"},
      "image": "scanner-p2net:local",
      "environment": {"NETWORK_LAB_ROLE": "router", "NETWORK_LAB_START_FRR": "${NETWORK_LAB_START_FRR:-0}"},
      "cap_drop": ["ALL"],
      "cap_add": ["NET_ADMIN", "NET_RAW", "NET_BIND_SERVICE", "SETUID", "SETGID", "CHOWN", "DAC_OVERRIDE", "FOWNER"],
      "security_opt": ["no-new-privileges:true"],
      "mem_limit": "256m", "cpus": 0.5, "pids_limit": 96, "restart": "no",
      "sysctls": {"net.ipv4.ip_forward": "1", "net.ipv6.conf.all.disable_ipv6": "1"},
      "networks": {
        "management": {"ipv4_address": "10.203.0.254", "interface_name": "mgmt0"},
        "data_a": {"ipv4_address": "10.203.10.254", "interface_name": "data0"},
        "data_b": {"ipv4_address": "10.203.20.254", "interface_name": "data1"}
      }
    },
    "client-a": {
      "image": "scanner-p2net:local", "environment": {"NETWORK_LAB_ROLE": "client-a"},
      "cap_drop": ["ALL"], "cap_add": ["NET_ADMIN", "NET_RAW"],
      "security_opt": ["no-new-privileges:true"], "mem_limit": "64m", "cpus": 0.25,
      "pids_limit": 24, "restart": "no",
      "networks": {"data_a": {"ipv4_address": "10.203.10.10", "interface_name": "data0"}}
    },
    "client-b": {
      "image": "scanner-p2net:local", "environment": {"NETWORK_LAB_ROLE": "client-b"},
      "cap_drop": ["ALL"], "cap_add": ["NET_ADMIN", "NET_RAW"],
      "security_opt": ["no-new-privileges:true"], "mem_limit": "64m", "cpus": 0.25,
      "pids_limit": 24, "restart": "no",
      "networks": {"data_b": {"ipv4_address": "10.203.20.10", "interface_name": "data0"}}
    }
  },
  "networks": {
    "management": {"driver": "bridge", "internal": true, "ipam": {"config": [{"subnet": "10.203.0.0/24"}]}},
    "data_a": {"driver": "bridge", "internal": true, "ipam": {"config": [{"subnet": "10.203.10.0/24"}]}},
    "data_b": {"driver": "bridge", "internal": true, "ipam": {"config": [{"subnet": "10.203.20.0/24"}]}}
  }
}
