{
  "name": "scanner-p2ips",
  "services": {
    "gateway": {
      "image": "scanner-p2ips-node:local",
      "pull_policy": "never",
      "environment": {
        "IPS_LAB_ROLE": "gateway"
      },
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=32m"
      ],
      "mem_limit": "96m",
      "pids_limit": 32,
      "sysctls": {
        "net.ipv4.ip_forward": "1",
        "net.ipv4.conf.all.send_redirects": "0",
        "net.ipv4.conf.default.send_redirects": "0",
        "net.ipv4.conf.all.accept_redirects": "0",
        "net.ipv4.conf.default.accept_redirects": "0",
        "net.ipv6.conf.all.disable_ipv6": "1"
      },
      "networks": {
        "fabric": {
          "ipv4_address": "10.207.10.254",
          "interface_name": "data0",
          "driver_opts": {
            "com.docker.network.endpoint.sysctls": "net.ipv4.conf.IFNAME.send_redirects=0,net.ipv4.conf.IFNAME.accept_redirects=0,net.ipv4.conf.IFNAME.forwarding=1"
          }
        }
      },
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile.node"
      }
    },
    "client": {
      "image": "scanner-p2ips-node:local",
      "pull_policy": "never",
      "environment": {
        "IPS_LAB_ROLE": "client"
      },
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=32m"
      ],
      "mem_limit": "96m",
      "pids_limit": 32,
      "sysctls": {
        "net.ipv4.ip_forward": "0",
        "net.ipv4.conf.all.send_redirects": "0",
        "net.ipv4.conf.default.send_redirects": "0",
        "net.ipv4.conf.all.accept_redirects": "0",
        "net.ipv4.conf.default.accept_redirects": "0",
        "net.ipv6.conf.all.disable_ipv6": "1"
      },
      "networks": {
        "fabric": {
          "ipv4_address": "10.207.10.10",
          "interface_name": "data0",
          "driver_opts": {
            "com.docker.network.endpoint.sysctls": "net.ipv4.conf.IFNAME.send_redirects=0,net.ipv4.conf.IFNAME.accept_redirects=0,net.ipv4.conf.IFNAME.forwarding=0"
          }
        }
      }
    },
    "server": {
      "image": "scanner-p2ips-node:local",
      "pull_policy": "never",
      "environment": {
        "IPS_LAB_ROLE": "server"
      },
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=32m"
      ],
      "mem_limit": "96m",
      "pids_limit": 32,
      "sysctls": {
        "net.ipv4.ip_forward": "0",
        "net.ipv4.conf.all.send_redirects": "0",
        "net.ipv4.conf.default.send_redirects": "0",
        "net.ipv4.conf.all.accept_redirects": "0",
        "net.ipv4.conf.default.accept_redirects": "0",
        "net.ipv6.conf.all.disable_ipv6": "1"
      },
      "networks": {
        "fabric": {
          "ipv4_address": "10.207.20.10",
          "interface_name": "data0",
          "driver_opts": {
            "com.docker.network.endpoint.sysctls": "net.ipv4.conf.IFNAME.send_redirects=0,net.ipv4.conf.IFNAME.accept_redirects=0,net.ipv4.conf.IFNAME.forwarding=0"
          }
        }
      }
    },
    "sensor": {
      "image": "scanner-p2ips-sensor:local",
      "pull_policy": "never",
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile.sensor"
      },
      "user": "0:0",
      "network_mode": "service:gateway",
      "depends_on": [
        "gateway"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m"
      ],
      "mem_limit": "512m",
      "pids_limit": 96
    }
  },
  "networks": {
    "fabric": {
      "driver": "bridge",
      "internal": true,
      "ipam": {
        "config": [
          {
            "subnet": "10.207.0.0/16",
            "aux_addresses": {
              "gateway_b": "10.207.20.254"
            }
          }
        ]
      }
    }
  }
}
